# Local development only. Copy to .env.local and edit.
#
# The OCI registry the content provider discovers execution environments from.
# Any OCI-compliant registry works; a local zot or registry:2 is enough.
CONTENT_REGISTRY_URL=http://127.0.0.1:8080

# Credentials are read from the environment, not from this file. Export them in the
# shell that starts the backend. A local unauthenticated registry needs neither.
#   export CONTENT_REGISTRY_USERNAME=demo
#   export CONTENT_REGISTRY_PASSWORD=...
