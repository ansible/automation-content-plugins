# Local development only. Copy to .env.local and edit.
#
# The OCI registry the content provider discovers content from. The local Quay started
# by dev/quay/setup.sh listens here; see docs/guides/local-registry.md.
CONTENT_REGISTRY_URL=http://127.0.0.1:8080

# Credentials are read from the environment rather than from this file, so a secret
# never lands in a file you might commit. dev/quay/setup.sh writes them to
# dev/quay/.env (gitignored):
#
#   set -a; . dev/quay/.env; set +a
#   export CONTENT_REGISTRY_USERNAME="$QUAY_USERNAME"
#   export CONTENT_REGISTRY_PASSWORD="$QUAY_PASSWORD"
