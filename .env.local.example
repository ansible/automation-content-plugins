# Local development only. Copy to .env.local and edit.
#
# The OCI registry the content provider discovers content from. Any OCI-compliant
# registry works; see "A registry to develop against" in README.md for a local one.
CONTENT_REGISTRY_URL=http://127.0.0.1:5000

# Credentials are read from the environment rather than from this file, so a token
# never lands in a file you might commit. A local unauthenticated registry needs
# neither; set `auth: { type: anonymous }` in app-config.yaml instead.
#
#   export CONTENT_REGISTRY_USERNAME=...
#   export CONTENT_REGISTRY_PASSWORD=...
