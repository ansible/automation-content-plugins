{
  "name": "@ansible/content-type-helm-chart",
  "version": "0.1.0",
  "description": "Helm chart content type: recognises Helm charts stored in an OCI registry. Deliberately minimal — it exists to demonstrate that a content type is something you add, not something you edit.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "common-library"
  },
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ansible/automation-content-common": "workspace:^",
    "@ansible/content-model": "workspace:^"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0"
  }
}
